@page
@model MeetingProtocols.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5">
    <h2>Вход в систему</h2>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-danger">@Model.Message</div>
    }
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Email (логин)</label>
            <input type="email" class="form-control" asp-for="Email" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input type="password" class="form-control" asp-for="Password" required />
        </div>
        <button type="submit" class="btn btn-primary">Войти</button>
    </form>
    <p class="mt-3">Нет аккаунта? <a asp-page="/Register">Зарегистрироваться</a></p>
</div>
